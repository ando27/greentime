# Copy this file to .env.local and fill in both values.
# Find them in Supabase: Project Settings -> Data API (URL) and API Keys (anon / publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: one-tap "Test login" button on the sign-in page (never active on the live site).
# Use the email and password of a real GreenTime account. Leave blank to turn it off.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
